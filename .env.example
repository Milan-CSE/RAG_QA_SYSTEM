# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for LLM-powered answers and optional LLM-based routing/extraction.
# Leave blank to run in fallback (context-only) mode.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2

# ─── Document Chunking ────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Vector Store ─────────────────────────────────────────────────────────────
CHROMA_COLLECTION=hybrid_qa
TOP_K_RETRIEVAL=5

# ─── spaCy ────────────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ─── Neo4j (optional — leave blank to use NetworkX fallback) ──────────────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
